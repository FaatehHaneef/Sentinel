# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Braintree sandbox (a PayPal service). Sandbox only: Sentinel refuses to run
# against a live payments environment.
# Get these at sandbox.braintreegateway.com > gear icon > API > Keys.
BRAINTREE_MERCHANT_ID=
BRAINTREE_PUBLIC_KEY=
BRAINTREE_PRIVATE_KEY=

# Gemini API key from aistudio.google.com > Get API key.
# Optional: without a key, Sentinel uses its built-in explanations and says so.
# Give one key, a comma-separated list, or numbered GEMINI_API_KEY_1, _2, ...
GEMINI_API_KEYS=

# Public address of the deployment, for example https://sentinel.example.
# Optional on Vercel and for local development.
APP_ORIGIN=
